FROM ubuntu:24.04

ARG TARGETARCH
ARG NODE_VERSION=22.23.2
ARG NODE_SHA256_AMD64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
ARG NODE_SHA256_ARM64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8
ARG PNPM_VERSION=9.15.9

ENV CI=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl xz-utils \
    && case "${TARGETARCH}" in \
         amd64) node_arch="x64"; node_sha256="${NODE_SHA256_AMD64}" ;; \
         arm64) node_arch="arm64"; node_sha256="${NODE_SHA256_ARM64}" ;; \
         *) echo "Unsupported Ubuntu test image architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && node_archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    && curl --fail --location --retry 3 --output "/tmp/${node_archive}" \
       "https://nodejs.org/dist/v${NODE_VERSION}/${node_archive}" \
    && echo "${node_sha256}  /tmp/${node_archive}" | sha256sum --check --strict \
    && tar --extract --file "/tmp/${node_archive}" --directory /usr/local --strip-components=1 \
    && rm "/tmp/${node_archive}" \
    && npm install --global "pnpm@${PNPM_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Match the repository's Linux CI setup for Electron/Chromium runtime libraries.
RUN pnpm exec playwright install-deps \
    && apt-get update \
    && apt-get install --yes --no-install-recommends xauth xvfb \
    && command -v xvfb-run \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Provide Radar's managed browser at one of its allowlisted Linux paths.
RUN install_attempt=1; \
    until pnpm exec playwright install chromium --no-shell; do \
      if [ "${install_attempt}" -ge 3 ]; then exit 1; fi; \
      install_attempt=$((install_attempt + 1)); \
      echo "Retrying Playwright browser download (${install_attempt}/3)"; \
    done

RUN chromium_path="$(node -e "const { chromium } = require('@playwright/test'); process.stdout.write(chromium.executablePath())")" \
    && test -x "${chromium_path}" \
    && ln --symbolic "${chromium_path}" /usr/bin/chromium \
    && useradd --create-home --uid 10001 --shell /bin/bash radar

# Electron is downloaded lazily by the npm package. Materialize it while the
# image is built so ordinary test runs do not need network access.
RUN download_attempt=1; \
    until node -e "const executablePath = require('electron'); if (typeof executablePath !== 'string' || !executablePath.trim()) process.exit(1)"; do \
      if [ "${download_attempt}" -ge 3 ]; then exit 1; fi; \
      download_attempt=$((download_attempt + 1)); \
      echo "Retrying Electron binary download (${download_attempt}/3)"; \
    done

COPY --chown=radar:radar . .
RUN chown --recursive radar:radar /workspace

USER radar

CMD ["pnpm", "test:container:ubuntu"]
